$(eval $(call addlib,apprxflags))
NGHTTPX_APP_BASE := $(APP_BASE)/../../app-nghttpx
include $(NGHTTPX_APP_BASE)/Makefile.deployment
APPRXFLAGS_SRCS-y += $(NGHTTPX_APP_BASE)/main.c $(NGHTTPX_DEPLOYMENT_SRCS-y)
APPRXFLAGS_SRCS-y += $(APP_BASE)/udp_rxflags.c
LDFLAGS-y += -Wl,--wrap=recvmsg -Wl,--wrap=ngtcp2_pkt_decode_version_cid
