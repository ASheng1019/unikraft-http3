# SPDX-License-Identifier: BSD-3-Clause
.PHONY: lwip-selection
lwip-selection:
	@printf '%s\n' 'LWIP_URL=$(LIBLWIP_URL)' 'LWIP_ZIP=$(LIBLWIP_ZIPNAME)' 'LWIP_SHA=$(LIBLWIP_ORIGIN_SHA256)' 'LWIP_FIX_STAGE=$(filter %/.pinned-patched,$(UK_FETCH-y))' 'LWIP_RECVINFO=$(CONFIG_LWIP_NETBUF_RECVINFO)' 'LWIP_ACK_MS=$(CONFIG_LWIP_TCP_ACK_DELAY_MS)' 'LWIP_DEFER_RX=$(CONFIG_LWIP_UKNETDEV_DEFER_STATUS_RX)'

.PHONY: runtime-selection
runtime-selection:
	@printf '%s\n' 'CXX_VERSION=$(LIBCXX_VERSION)' 'CXX_URL=$(LIBCXX_URL)' 'CXX_SHA=$(LIBCXX_ORIGIN_SHA256)' 'ABI_VERSION=$(LIBCXXABI_VERSION)' 'ABI_URL=$(LIBCXXABI_URL)' 'ABI_SHA=$(LIBCXXABI_ORIGIN_SHA256)' 'UNWIND_VERSION=$(LIBUNWIND_VERSION)' 'UNWIND_URL=$(LIBUNWIND_URL)' 'UNWIND_SHA=$(LIBUNWIND_ORIGIN_SHA256)'
