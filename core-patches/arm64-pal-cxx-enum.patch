From 3e6c3bccfbdcd465f794bca18c81dbf08743eed8 Mon Sep 17 00:00:00 2001
From: Sheng <hsdai22@m.fudan.edu.cn>
Date: Fri, 30 Oct 2026 17:07:04 +0800
Subject: [PATCH] plat/native/arm64: Cast exception level bits for C++
 consumers

Signed-off-by: Sheng <hsdai22@m.fudan.edu.cn>
---
 plat/native/pal/arch/arm64/include/uk/plat/pal/arch/except.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/plat/native/pal/arch/arm64/include/uk/plat/pal/arch/except.h b/plat/native/pal/arch/arm64/include/uk/plat/pal/arch/except.h
index 0d2cad5a5..4f4c8f29b 100644
--- a/plat/native/pal/arch/arm64/include/uk/plat/pal/arch/except.h
+++ b/plat/native/pal/arch/arm64/include/uk/plat/pal/arch/except.h
@@ -41,7 +41,8 @@ __isr static inline void
 uk_pal_arm64_except_err_ctx_set_eid(struct uk_pal_except_err_ctx *ctx, int eid)
 {
 	uk_plat_native_arm64_except_err_ctx_set_eid(
-		(struct uk_plat_native_except_err_ctx *)ctx, eid);
+		(struct uk_plat_native_except_err_ctx *)ctx,
+		(enum uk_plat_native_arm64_except_id)eid);
 }
 
 __isr static inline __u64
