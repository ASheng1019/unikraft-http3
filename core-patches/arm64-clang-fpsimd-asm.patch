From f0f58e0a08e93fbc5ce3889bd38b58ff2187e61b Mon Sep 17 00:00:00 2001
From: Sheng <hsdai22@m.fudan.edu.cn>
Date: Fri, 30 Oct 2026 17:07:04 +0800
Subject: [PATCH] plat/native/arm64: Enable FPSIMD instructions for clang
 assembly

Signed-off-by: Sheng <hsdai22@m.fudan.edu.cn>
---
 plat/native/arch/arm64/ectx.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/plat/native/arch/arm64/ectx.c b/plat/native/arch/arm64/ectx.c
index a8f5a1464..e7ad693d5 100644
--- a/plat/native/arch/arm64/ectx.c
+++ b/plat/native/arch/arm64/ectx.c
@@ -33,6 +33,8 @@ static void fpsimd_save_state(__uptr ptr)
 	__u32 fpcr, fpsr;
 
 	__asm__ __volatile__(
+		".arch_extension fp\n"
+		".arch_extension simd\n"
 		"mrs	%0, fpcr\n"
 		"mrs	%1, fpsr\n"
 		"stp	q0,  q1,  [%2, #16 *  0]\n"
@@ -65,6 +67,8 @@ static void fpsimd_restore_state(__uptr ptr)
 	fpsr = ((struct fpsimd_state *)ptr)->fpsr;
 
 	__asm__ __volatile__(
+		".arch_extension fp\n"
+		".arch_extension simd\n"
 		"ldp	q0,  q1,  [%2, #16 *  0]\n"
 		"ldp	q2,  q3,  [%2, #16 *  2]\n"
 		"ldp	q4,  q5,  [%2, #16 *  4]\n"
-- 
2.43.0

